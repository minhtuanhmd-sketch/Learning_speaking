# ==============================================================================
# BOTKEEP.CLOUD ENVIRONMENT CONFIGURATION (Node.js 22)
# ==============================================================================

# Cổng mạng server lắng nghe trên Botkeep (Mặc định: 8434)
PORT=8434

# Host binding bắt buộc để truy cập từ ngoài (0.0.0.0)
HOST=0.0.0.0

# Khóa API Google Gemini AI cho tính năng phát âm thanh chuẩn phòng thu
GEMINI_API_KEY=your_gemini_api_key_here

# Môi trường chạy (production khi triển khai trên Botkeep)
NODE_ENV=production

# Tên miền Botkeep mặc định được cấp phát
APP_URL=http://node10.botkeep.cloud:8434
